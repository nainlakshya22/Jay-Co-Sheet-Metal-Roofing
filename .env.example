# =========================================================================
# JAY-CO SHEET METAL & ROOFING — PRODUCTION ENVIRONMENT VARIABLES
# =========================================================================

# Server Port (Defaults to 3000 if unset)
PORT=3000

# Node Environment
NODE_ENV=production

# -------------------------------------------------------------------------
# OUTBOUND LEAD DISPATCH NOTIFICATIONS
# Configure EITHER SMTP (Nodemailer) OR Resend HTTP API.
# If both are omitted, the server operates in safe local storage mode
# (leads are persisted atomically to leads.json without crashing).
# -------------------------------------------------------------------------

# Primary Destination Email for Houston Estimating Desk
DISPATCH_EMAIL=jaycosm@sbcglobal.com

# OPTION A: SMTP Credentials (SendGrid, Mailgun, Amazon SES, Postmark, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_api_key_here
SMTP_FROM="Jay-Co Estimating Desk <dispatch@jaycoroofing.com>"

# OPTION B: Resend HTTP Transactional API Key
# RESEND_API_KEY=re_123456789abcdef

# -------------------------------------------------------------------------
# GOOGLE BUSINESS PROFILE & PLACES API
# Optional: Supply API key if dynamic Google Places reviews synchronization
# is preferred over the default curated public review snapshot.
# -------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=AIzaSyYourGoogleApiKeyHere
# GOOGLE_PLACE_ID=ChIJ...
